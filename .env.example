# Copiez ce fichier vers .env et remplacez toutes les valeurs d'exemple.
POSTGRES_USER=briandri
POSTGRES_PASSWORD=changez-ce-secret-postgresql
POSTGRES_DB=travel_agency_db
DB_USER=briandri
DB_PASSWORD=changez-ce-secret-postgresql
DB_NAME=travel_agency_db

JWT_ACCESS_SECRET=generez-un-secret-long-et-aleatoire
PUBLIC_APP_URL=https://voyages.example.com

# SMTP : STARTTLS (587) dans cet exemple. Utilisez SMTP_SECURE=true avec 465.
SMTP_HOST=smtp.votre-fournisseur.tld
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@voyages.example.com
SMTP_PASSWORD=mot-de-passe-ou-cle-api-smtp
SMTP_FROM=Travel Agency <no-reply@voyages.example.com>
