# PostgreSQL
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change-me-with-a-long-random-password
POSTGRES_DB=travel_agency_db
DB_NAME=travel_agency_db

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-48-byte-random-secret
# Origine réellement exposée aux navigateurs (sans slash final). En production,
# utilisez par exemple http://192.168.88.226 si un reverse-proxy publie le port 80.
PUBLIC_APP_URL=http://localhost
FRONTEND_PORT=80

# Optional: promoted once this address has registered.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# SMTP production (leave user/password blank only for a relay such as MailHog)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM="Travel Agency <no-reply@example.com>"
